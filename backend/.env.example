# ==============================================================================
# Clinic Appointment Booking - Backend Environment Configuration (.env.example)
# Copy this file to .env and replace placeholders with your actual settings.
# ==============================================================================

# PostgreSQL database connection URL (e.g. Render PostgreSQL or local PostgreSQL)
# Supports postgres://, postgresql://, or postgresql+psycopg:// prefixes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Dedicated test database connection URL used by pytest for real Postgres concurrency testing
# Example: postgresql://USER:PASSWORD@HOST:5432/clinic_booking_test
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/clinic_booking_test

# Secret key used for signing JWT access tokens (generate with `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# Access token expiration time in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# Official timezone for clinic operations (weekday calculation, booking slots)
# Default: Asia/Kolkata
CLINIC_TIMEZONE=Asia/Kolkata

# Allowed CORS origin(s) for the frontend application (comma-separated if multiple)
# In development: http://localhost:5173
# In production: https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Minimum hours required before appointment start time to allow patient cancellation or reschedule
# Default: 2
CANCEL_CUTOFF_HOURS=2

# Maximum number of days into the future patients are allowed to book appointments
# Default: 60
BOOKING_WINDOW_DAYS=60

# Optional buffer in minutes before a slot can be booked (e.g. 0 allows booking up to slot start)
SLOT_BUFFER_MINUTES=0

# Flag to enable optional external SMTP email reminders (OFF by default for Render free tier)
EMAIL_REMINDERS_ENABLED=false

# Optional SMTP Settings (required only if EMAIL_REMINDERS_ENABLED=true)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=no-reply@clinic.com
SMTP_TLS=true
