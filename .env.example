# Primary PostgreSQL database connection string (internal or production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Dedicated PostgreSQL connection string for tests (never run tests against main DATABASE_URL)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/clinic_test_db

# Local development database URL when working outside the Render internal network
DEV_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/clinic_db

# Strong secret key for signing JWT bearer tokens
JWT_SECRET=replace-with-a-secure-random-64-character-hex-string

# Access token expiry duration in minutes
JWT_EXPIRE_MINUTES=1440

# Clinic reference timezone for date, weekday, and slot generation math
CLINIC_TIMEZONE=Asia/Kolkata

# Allowed frontend CORS origins (comma-separated, without trailing slashes)
# In development: http://localhost:5173
# In production: https://clinic-appointment-booking-ten.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,https://clinic-appointment-booking-ten.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Server host and port (falls back to 0.0.0.0 and 8000)
HOST=0.0.0.0
PORT=8000

# Optional Google Gemini API key
GEMINI_API_KEY=

# Minimum hours prior to an appointment below which patient cancellation and rescheduling are blocked
CANCEL_CUTOFF_HOURS=2

# Maximum forward window in days for which appointment booking slots are generated
BOOKING_WINDOW_DAYS=60

# Optional buffer in minutes between consecutive appointment slots
SLOT_BUFFER_MINUTES=0

# Flag to enable or disable background email reminder delivery via SMTP
EMAIL_REMINDERS_ENABLED=false

# SMTP server hostname for sending email reminders
SMTP_HOST=localhost

# SMTP server port (e.g. 587 for STARTTLS, 465 for SSL, 1025 for local dev)
SMTP_PORT=1025

# SMTP authentication username
SMTP_USER=

# SMTP authentication password
SMTP_PASSWORD=

# Sender email address for reminder notifications
SMTP_FROM_EMAIL=no-reply@clinic.example.com

# Whether to enable TLS/STARTTLS for SMTP connections
SMTP_TLS=false
